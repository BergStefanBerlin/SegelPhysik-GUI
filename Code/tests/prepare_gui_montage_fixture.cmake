if(NOT DEFINED SOURCE_DIR OR NOT IS_DIRECTORY "${SOURCE_DIR}")
    message(FATAL_ERROR "GUI montage source model directory is missing: ${SOURCE_DIR}")
endif()
if(NOT DEFINED FIXTURE_DIR OR "${FIXTURE_DIR}" STREQUAL "")
    message(FATAL_ERROR "GUI montage fixture directory was not configured")
endif()

get_filename_component(source_real "${SOURCE_DIR}" REALPATH)
get_filename_component(fixture_real "${FIXTURE_DIR}" REALPATH)
if(source_real STREQUAL fixture_real)
    message(FATAL_ERROR "GUI montage fixture must not be the original model directory")
endif()

set(seed_dir "${FIXTURE_DIR}/seed")
set(models_dir "${FIXTURE_DIR}/models")
set(seed_marker "${seed_dir}/.prepared-v2")
if(NOT EXISTS "${seed_marker}")
    file(GLOB model_directories LIST_DIRECTORIES true "${SOURCE_DIR}/*")
    set(model_count 0)
    foreach(model_dir IN LISTS model_directories)
        if(NOT IS_DIRECTORY "${model_dir}"
            OR NOT EXISTS "${model_dir}/modells_information.json")
            continue()
        endif()
        math(EXPR model_count "${model_count} + 1")
        file(GLOB_RECURSE model_files LIST_DIRECTORIES false "${model_dir}/*")
        foreach(source_file IN LISTS model_files)
            file(RELATIVE_PATH relative_path "${SOURCE_DIR}" "${source_file}")
            file(TO_CMAKE_PATH "${relative_path}" relative_path)
            string(TOLOWER "${relative_path}" relative_lower)
            get_filename_component(extension "${source_file}" EXT)
            string(TOLOWER "${extension}" extension)
            if(relative_lower MATCHES "(^|/)(\\.git|[^/]*wind[^/]*)/"
                OR relative_lower MATCHES "(^|/)[^/]*wind[^/]*$"
                OR extension STREQUAL ".csv"
                OR extension STREQUAL ".lock")
                continue()
            endif()
            set(destination "${seed_dir}/${relative_path}")
            get_filename_component(destination_dir "${destination}" DIRECTORY)
            file(MAKE_DIRECTORY "${destination_dir}")
            file(COPY_FILE "${source_file}" "${destination}" ONLY_IF_DIFFERENT)
        endforeach()
    endforeach()
    if(NOT model_count EQUAL 11)
        message(FATAL_ERROR
            "Expected 11 legacy model folders for GUI montage, found ${model_count}")
    endif()
    file(WRITE "${seed_marker}" "Prepared from ${source_real}\n")
endif()

if(NOT EXISTS "${models_dir}/.prepared")
    file(MAKE_DIRECTORY "${models_dir}")
    file(COPY "${seed_dir}/" DESTINATION "${models_dir}")
    file(WRITE "${models_dir}/.prepared" "Persistent GUI montage working copy\n")
endif()

file(GLOB_RECURSE seed_json LIST_DIRECTORIES false "${seed_dir}/*.json")
foreach(seed_file IN LISTS seed_json)
    file(RELATIVE_PATH relative_path "${seed_dir}" "${seed_file}")
    set(working_file "${models_dir}/${relative_path}")
    get_filename_component(working_dir "${working_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${working_dir}")
    file(COPY_FILE "${seed_file}" "${working_file}" ONLY_IF_DIFFERENT)
endforeach()

file(GLOB_RECURSE lock_files LIST_DIRECTORIES false "${models_dir}/*.lock")
if(lock_files)
    file(REMOVE ${lock_files})
endif()

file(GLOB_RECURSE fixture_files LIST_DIRECTORIES false "${models_dir}/*")
foreach(fixture_file IN LISTS fixture_files)
    file(RELATIVE_PATH relative_path "${models_dir}" "${fixture_file}")
    file(TO_CMAKE_PATH "${relative_path}" relative_path)
    string(TOLOWER "${relative_path}" relative_lower)
    get_filename_component(extension "${fixture_file}" EXT)
    string(TOLOWER "${extension}" extension)
    if(relative_lower MATCHES "(^|/)(\\.git|[^/]*wind[^/]*)/"
        OR relative_lower MATCHES "(^|/)[^/]*wind[^/]*$"
        OR extension STREQUAL ".csv")
        message(FATAL_ERROR "Forbidden aerodynamic or windfield data in GUI fixture: ${relative_path}")
    endif()
endforeach()
